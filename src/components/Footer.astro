---
const year = new Date().getFullYear();
---

<footer class="bg-alpha-black text-alpha-cream">
  <div class="container-wide py-12 grid gap-10 md:grid-cols-3">
    <div>
      <p class="eyebrow text-alpha-gold-300">First of All</p>
      <p class="eyebrow text-alpha-gold-300 mt-1">Servants of All</p>
      <p class="eyebrow text-alpha-gold-300 mt-1">We Shall Transcend All</p>
      <p class="mt-6 font-serif text-2xl">The Alpha Chapter</p>
      <p class="font-serif text-lg text-alpha-cream/70">
        Alpha Phi Alpha Fraternity, Inc. · 1906
      </p>
    </div>

    <div>
      <p class="eyebrow text-alpha-gold-300">Explore</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/founding" class="hover:text-alpha-gold-300">The Founding</a></li>
        <li><a href="/chapter" class="hover:text-alpha-gold-300">Alpha Chapter</a></li>
        <li><a href="/house-of-alpha" class="hover:text-alpha-gold-300">House of Alpha</a></li>
        <li><a href="/events" class="hover:text-alpha-gold-300">Events</a></li>
        <li><a href="/posts" class="hover:text-alpha-gold-300">Posts</a></li>
        <li><a href="/contact" class="hover:text-alpha-gold-300">Contact</a></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow text-alpha-gold-300">Connect</p>
      <ul class="mt-4 space-y-2 text-sm">
        <li>
          <a href="https://instagram.com/" class="hover:text-alpha-gold-300">
            Instagram
          </a>
        </li>
        <li>
          <a href="mailto:contact@example.com" class="hover:text-alpha-gold-300">
            Email
          </a>
        </li>
        <li>
          <a href="https://apa1906.net" class="hover:text-alpha-gold-300">
            National Site (apa1906.net)
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-alpha-cream/10">
    <div class="container-wide py-6 text-xs text-alpha-cream/60 flex flex-col sm:flex-row justify-between gap-2">
      <p>&copy; {year} The Alpha Chapter of Alpha Phi Alpha Fraternity, Inc.</p>
      <p class="tracking-widest uppercase">Cornell University · Ithaca, NY</p>
    </div>
  </div>
</footer>
