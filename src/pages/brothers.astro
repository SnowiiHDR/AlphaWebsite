---
import Layout from "@/layouts/Layout.astro";

type BrotherPosition = {
  title: string;
  name: string;
  major: string;
  grade: string;
  image?: string;
};

const chapterPositions: BrotherPosition[] = [
  {
    title: "President",
    name: "Colin Michael",
    major: "Major",
    grade: "Senior",
    image: "/michael.png",
  },
  {
    title: "Vice President",
    name: "Osiel Iglesias-Faez",
    major: "Major",
    grade: "Junior",
    image: "/faez.png",
  },
  {
    title: "Secretary",
    name: "Zion Singleton",
    major: "Major",
    grade: "Senior",
  },
  {
    title: "Treasurer",
    name: "Elliot Rosa",
    major: "Economics",
    grade: "Sophomore",
  },
  {
    title: "Programming Chair",
    name: "Jacob Green",
    major: "AEM",
    grade: "Junior",
  },
  {
    title: "Public Relations Chair",
    name: "Tyler Japal",
    major: "Major",
    grade: "Senior",
    image: "/japal.png",
  },
  {
    title: "Service Chair",
    name: "Noah Hoereth",
    major: "Major",
    grade: "Sophomore",
  },
  {
    title: "Alumni Relations Chair",
    name: "Christian Flournoy",
    major: "Major",
    grade: "Senior",
    image: "/flournoy.png",
  },
  {
    title: "Historian",
    name: "Jeremy Henderson",
    major: "Major",
    grade: "Senior",
    image: "/henderson.png",
  },
];
---

<Layout
  title="Brothers on the Yard — The Alpha Chapter"
  description="Meet the active leadership and brothers on the yard of the Alpha Chapter of Alpha Phi Alpha Fraternity, Inc. at Cornell University."
>
  <section class="bg-alpha-black text-alpha-cream">
    <div class="container-wide py-12 sm:py-16">
      <p class="eyebrow text-alpha-gold-300">Chapter Leadership</p>
      <h1 class="mt-3 max-w-4xl font-serif text-3xl leading-tight sm:text-5xl lg:text-6xl">
        Brothers on the Yard.
      </h1>
    </div>
  </section>

  <section class="bg-alpha-cream py-12 sm:py-16">
    <div class="container-wide">
      
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          chapterPositions.map((brother) => (
            <article class="group border border-alpha-black/10 bg-alpha-cream transition-all duration-200 hover:border-alpha-gold-400 hover:shadow-sm">
              
              {/* Flattened landscape aspect ratio reduces card height drastically */}
              {brother.image ? (
                <div class="aspect-[21/9] w-full overflow-hidden bg-alpha-black">
                  <img
                    src={brother.image}
                    alt={brother.name}
                    class="h-full w-full object-cover transition duration-300 group-hover:opacity-90"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="flex aspect-[21/9] w-full items-center justify-center bg-alpha-black text-alpha-gold-300">
                  <span class="font-serif text-2xl tracking-wider">ΑΦΑ</span>
                </div>
              )}
              
              {/* Reduced compact padding */}
              <div class="p-4">
                <span class="block text-[0.65rem] tracking-wider uppercase font-semibold text-alpha-gold-400 mb-0.5 truncate">
                  {brother.title}
                </span>
                
                {/* Guaranteed single-line size */}
                <h3 class="font-serif text-lg sm:text-xl text-alpha-black leading-tight tracking-tight truncate">
                  {brother.name}
                </h3>
                
                <div class="mt-2.5 border-t border-alpha-black/5 pt-2">
                  <p class="text-[0.8rem] text-alpha-ink/70 truncate">
                    {brother.grade} &bull; {brother.major}
                  </p>
                </div>
              </div>

            </article>
          ))
        }
      </div>

    </div>
  </section>
</Layout>