---
import Layout from "@/layouts/Layout.astro";

const jewels = [
  "Henry Arthur Callis",
  "Charles Henry Chapman",
  "Eugene Kinckle Jones",
  "George Biddle Kelley",
  "Nathaniel Allison Murray",
  "Robert Harold Ogle",
  "Vertner Woodson Tandy",
];

const jewelNames = jewels.join(", ");

const pillars = [
  {
    title: "Tidbit 1.",
    body: "On December 4, 1906, seven men at Cornell founded the first intercollegiate fraternity for African American men. The Alpha Chapter is the chapter where it began.",
  },
  {
    title: "Something",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent egestas tristique nulla, sit amet facilisis leo tincidunt sit amet. Nulla in enim congue, iaculis risus vel, eleifend lectus",
  },
  {
    title: "Another thing.",
    body: "Manly Deeds. Scholarship. Love For All Mankind.",
  },
];
---

<Layout>
  <!-- HERO ============================================================= -->
  <section class="relative overflow-hidden bg-alpha-black text-alpha-cream">
    <div
      class="absolute inset-0 opacity-[0.06] pointer-events-none select-none"
      aria-hidden="true"
    >
      <div class="absolute inset-0 flex items-center justify-center">  
        <span class="font-serif text-[40vw] leading-none text-alpha-gold-400"
          >ΑΦΑ</span
        >
      </div>
    </div>

    <div class="container-wide relative py-16 sm:py-20 lg:py-24">
      <p class="eyebrow text-alpha-gold-300">Est. December 4, 1906 · Cornell University</p>
      <h1
        class="mt-4 font-serif text-4xl sm:text-6xl lg:text-7xl leading-[0.98]"
      >
        The Uppermost House.<br />
      </h1>
      <p class="mt-6 max-w-2xl text-lg sm:text-xl text-alpha-cream/80 font-serif">
        The Alpha Chapter of Alpha Phi Alpha Fraternity, Inc. — Lorem ipsum dolor sit amet,
        consectetur adipiscing elit. Praesent egestas tristique nulla,
        sit amet facilisis leo tincidunt sit amet. Nulla in enim congue.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/founding" class="btn-primary bg-alpha-gold-400 border-alpha-gold-400 text-alpha-black hover:bg-alpha-cream hover:border-alpha-cream">
          The Seven Jewels
        </a>
        <a href="/house-of-alpha" class="btn-ghost border-alpha-cream/40 text-alpha-cream hover:bg-alpha-cream hover:text-alpha-black">
          The House of Alpha
        </a>
      </div>

      <div
        class="mt-12 grid grid-cols-3 gap-6 max-w-3xl border-t border-alpha-cream/15 pt-6"
      >
        <div>
          <p class="eyebrow text-alpha-gold-300">First of All</p>
        </div>
        <div>
          <p class="eyebrow text-alpha-gold-300">Servants of All</p>
        </div>
        <div>
          <p class="eyebrow text-alpha-gold-300">We Shall Transcend All</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THREE PILLARS ===================================================== -->
  <section class="bg-alpha-cream py-16 sm:py-20">
    <div class="container-wide">
      <div class="grid gap-8 md:grid-cols-3">
        {
          pillars.map((p) => (
            <div class="border-t-2 border-alpha-gold-400 pt-6">
              <h2 class="font-serif text-3xl">{p.title}</h2>
              <p class="mt-3 text-alpha-ink/80 leading-relaxed">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FOUNDING NARRATIVE ================================================ -->
  <section class="bg-alpha-black text-alpha-cream py-16 sm:py-20 relative">
    <div class="container-wide grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <p class="eyebrow text-alpha-gold-300">The Story</p>
        <h2 class="mt-4 font-serif text-4xl sm:text-5xl leading-tight">
          A study group that<br />became a movement.
        </h2>
      </div>
      <div class="lg:col-span-7 space-y-6 text-alpha-cream/85 leading-relaxed">
        <p>
          In the 1905–1906 school year, a small group of African American
          students at Cornell met as a literary society and social studies club —
          seeking refuge.
        </p>
        <p>
          On December 4, 1906, that gathering became Alpha Phi Alpha Fraternity,
          the first intercollegiate Greek-letter organization established by men
          of African descent.
        </p>
        <div class="pt-4">
          <a
            href="/chapter"
            class="font-sans text-xs uppercase tracking-widest text-alpha-gold-300 hover:text-alpha-cream border-b border-alpha-gold-300 hover:border-alpha-cream pb-1 transition"
          >
            Read the chapter history &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SEVEN JEWELS PREVIEW ============================================== -->
  <section class="bg-alpha-cream py-16 sm:py-20">
    <div class="container-wide max-w-4xl">
      <div class="max-w-3xl">
        <h2 class="font-serif text-4xl sm:text-5xl leading-tight">
          The Seven Jewels
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-alpha-ink/80">
          The founders of Alpha Phi Alpha Fraternity, Inc. are {jewelNames}.
          Their stories mark the beginning of the Alpha Chapter and the
          brotherhood it established at Cornell.
        </p>
        <div class="mt-8">
          <a href="/founding" class="btn-ghost">Read Their Stories</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HOUSE OF ALPHA ==================================================== -->
  <section class="bg-alpha-black text-alpha-cream py-16 sm:py-20">
    <div class="container-wide grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <p class="eyebrow text-alpha-gold-300">Opened October 2025</p>
        <h2 class="mt-4 font-serif text-4xl sm:text-5xl leading-tight">
          The House of Alpha<br />Leadership Institute.
        </h2>
        <p class="mt-6 text-alpha-cream/80 leading-relaxed max-w-2xl">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent egestas tristique nulla, sit amet facilisis leo tincidunt sit amet. Nulla in enim congue.
        </p>
        <div class="mt-8">
          <a
            href="/house-of-alpha"
            class="btn-primary bg-alpha-gold-400 border-alpha-gold-400 text-alpha-black hover:bg-alpha-cream hover:border-alpha-cream"
          >
            Inside the House
          </a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div
          class="aspect-[4/5] bg-alpha-gold-400/10 border border-alpha-gold-400/30 flex items-center justify-center text-alpha-gold-300 font-serif text-xl"
        >
          <span>Photo placeholder</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA: GET INVOLVED ================================================= -->
  <section class="bg-alpha-cream py-16 sm:py-20">
    <div class="container-wide max-w-4xl text-center">
      <p class="eyebrow">Interested in Alpha?</p>
      <h2 class="mt-3 font-serif text-4xl sm:text-5xl">
        Stay connected with the Alpha Chapter.
      </h2>
      <p class="mt-4 text-alpha-ink/80 leading-relaxed max-w-2xl mx-auto">
        Whether you're a Cornell student, an Alpha alumnus, or a member of the
        community, we'd be glad to hear from you. Join the listserv for chapter
        announcements, events, and service opportunities.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="btn-primary">Get in touch</a>
        <a href="https://instagram.com/" class="btn-ghost">Follow on Instagram</a>
      </div>
    </div>
  </section>
</Layout>
