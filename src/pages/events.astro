---
import Layout from "@/layouts/Layout.astro";

// Replace with your Chapter's public Google Calendar ID
const calendarId = "c_your_calendar_id@group.calendar.google.com";
const calendarSrc = `https://calendar.google.com/calendar/embed?src=${encodeURIComponent(calendarId)}&ctz=America%2FNew_York`;

// Array of event objects, each containing an array of images for its carousel
const historyEvents = [
  {
    id: "chartering-day",
    title: "Chartering Day",
    year: "1906",
    images: [
      { src: "/images/charter-1.jpg", alt: "Chartering ceremony group photo" },
      { src: "/images/charter-2.jpg", alt: "Historic document exhibit" },
      { src: "/images/charter-3.jpg", alt: "Founders banner" },
    ],
  },
  {
    id: "black-gold-gala",
    title: "Annual Black & Gold Gala",
    year: "1985",
    images: [
      { src: "/images/gala-1.jpg", alt: "Brothers at the gala entrance" },
      { src: "/images/gala-2.jpg", alt: "Keynote presentation speech" },
    ],
  },
  {
    id: "community-service",
    title: "Community Service Initiative",
    year: "2010",
    images: [
      { src: "/images/service-1.jpg", alt: "Volunteers gathering supplies" },
      { src: "/images/service-2.jpg", alt: "Park cleanup group shot" },
      { src: "/images/service-3.jpg", alt: "Mentorship session" },
    ],
  },
  {
    id: "regional-convention",
    title: "Regional Convention",
    year: "2022",
    images: [
      { src: "/images/convention-1.jpg", alt: "Chapter delegation at plenary" },
      { src: "/images/convention-2.jpg", alt: "Awards acceptance on stage" },
    ],
  },
];
---

<Layout
  title="Events — The Alpha Chapter"
  description="Calendar and event history for Alpha Chapter of Alpha Phi Alpha Fraternity, Inc."
>
  {/* Header Section */}
  <section class="bg-alpha-black text-alpha-cream">
    <div class="container-wide py-12 sm:py-16">
      <p class="eyebrow text-alpha-gold-300">Schedule & Heritage</p>
      <h1 class="mt-3 max-w-4xl font-serif text-3xl leading-tight sm:text-5xl lg:text-6xl">
        Events.
      </h1>
    </div>
  </section>

  {/* Calendar Section */}
  <section class="bg-alpha-cream py-12 sm:py-16 border-b border-alpha-black/10">
    <div class="container-wide max-w-5xl">
      <h2 class="mb-6 font-serif text-2xl sm:text-3xl text-alpha-black">
        Calendar
      </h2>

      <div class="overflow-hidden rounded-lg border border-alpha-black/10 bg-white p-2 shadow-sm sm:p-4">
        <div class="relative w-full aspect-[4/3] sm:aspect-[16/10] lg:aspect-[16/9]">
          <iframe
            src={calendarSrc}
            style="border: 0"
            class="absolute top-0 left-0 w-full h-full rounded"
            frameborder="0"
            scrolling="no"
            title="Alpha Chapter Event Calendar"
            loading="lazy"
          ></iframe>
        </div>
      </div>

      <div class="mt-4 text-right">
        <a
          href={`https://calendar.google.com/calendar/render?cid=${encodeURIComponent(calendarId)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold text-alpha-gold-400 hover:underline"
        >
          + Add to Google Calendar
        </a>
      </div>
    </div>
  </section>

  {/* History Events Section (2 Columns with Carousel Cards) */}
  <section class="bg-alpha-cream py-12 sm:py-16">
    <div class="container-wide max-w-5xl">
      <div class="mb-8">
        <h2 class="font-serif text-2xl sm:text-3xl text-alpha-black">
          Events History
        </h2>
        <p class="mt-2 text-sm text-alpha-ink/70">
          A look back at historical moments, gatherings, and milestones throughout chapter history.
        </p>
      </div>

      {/* 2-Column Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          historyEvents.map((event) => (
            <article class="event-card overflow-hidden rounded border border-alpha-black/10 bg-white shadow-sm transition-all hover:border-alpha-gold-400">
              
              {/* Carousel Container */}
              <div class="relative aspect-video w-full overflow-hidden bg-alpha-black">
                
                {/* Scrollable Slides Track */}
                <div 
                  class="carousel-track flex h-full w-full overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth"
                  id={`carousel-${event.id}`}
                >
                  {event.images.map((img, index) => (
                    <div class="min-w-full h-full flex-shrink-0 snap-start relative">
                      <img
                        src={img.src}
                        alt={img.alt}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                      {/* Image count pill */}
                      <span class="absolute bottom-2 right-2 rounded bg-alpha-black/75 px-2 py-0.5 text-[10px] font-medium text-white backdrop-blur-sm">
                        {index + 1} / {event.images.length}
                      </span>
                    </div>
                  ))}
                </div>

                {/* Left / Right Carousel Controls (Only show if multiple images) */}
                {event.images.length > 1 && (
                  <>
                    <button
                      type="button"
                      aria-label="Previous photo"
                      class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 flex h-8 w-8 items-center justify-between justify-center rounded-full bg-alpha-black/60 text-white transition-all hover:bg-alpha-black"
                      data-target={`carousel-${event.id}`}
                    >
                      &#10094;
                    </button>
                    <button
                      type="button"
                      aria-label="Next photo"
                      class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 flex h-8 w-8 items-center justify-center rounded-full bg-alpha-black/60 text-white transition-all hover:bg-alpha-black"
                      data-target={`carousel-${event.id}`}
                    >
                      &#10095;
                    </button>
                  </>
                )}
              </div>

              {/* Event Metadata Footer */}
              <div class="p-4 flex items-center justify-between">
                <h3 class="font-serif text-lg text-alpha-black font-semibold">
                  {event.title}
                </h3>
                <span class="text-xs font-bold text-alpha-gold-400 font-sans tracking-wider">
                  {event.year}
                </span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

{/* Client Script for Carousel Arrow Navigation */}
<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Attach click listeners to all prev/next buttons
    document.querySelectorAll(".carousel-prev").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const track = document.getElementById(targetId);
        if (track) {
          track.scrollBy({ left: -track.clientWidth, behavior: "smooth" });
        }
      });
    });

    document.querySelectorAll(".carousel-next").forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = btn.getAttribute("data-target");
        const track = document.getElementById(targetId);
        if (track) {
          track.scrollBy({ left: track.clientWidth, behavior: "smooth" });
        }
      });
    });
  });
</script>

<style>
  /* Hide scrollbars for smooth aesthetic while retaining touch-swipe capabilities */
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>