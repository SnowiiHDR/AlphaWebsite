---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Contact Us — The Alpha Chapter"
  description="Get in touch with the Alpha Chapter of Alpha Phi Alpha Fraternity, Inc. at Cornell University."
>
  {/* Header Section */}
  <section class="bg-alpha-black text-alpha-cream">
    <div class="container-wide py-12 sm:py-16">
      <p class="eyebrow text-alpha-gold-300">Get In Touch</p>
      <h1 class="mt-3 max-w-4xl font-serif text-3xl leading-tight sm:text-5xl lg:text-6xl">
        Contact Us.
      </h1>
    </div>
  </section>

  {/* Main Contact Content */}
  <section class="bg-alpha-cream py-12 sm:py-16 border-b border-alpha-black/10">
    <div class="container-wide max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        {/* Contact Form (Left / 7 Cols) */}
        <div class="lg:col-span-7 bg-white p-6 sm:p-10 border border-alpha-black/10 shadow-sm">
          <h2 class="font-serif text-2xl sm:text-3xl text-alpha-black mb-6">Send a Message</h2>
          
          <form class="space-y-6" action="#" method="POST">
            {/* First & Last Name side-by-side */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="first-name" class="block text-[0.7rem] font-semibold uppercase tracking-wider text-alpha-black mb-2">
                  First Name
                </label>
                <input
                  type="text"
                  id="first-name"
                  name="first-name"
                  required
                  class="w-full rounded-none border border-alpha-black/20 bg-alpha-cream/20 pl-5 pr-4 py-3 text-sm text-alpha-black focus:border-alpha-gold-400 focus:bg-white focus:outline-none transition-colors"
                />
              </div>

              <div>
                <label for="last-name" class="block text-[0.7rem] font-semibold uppercase tracking-wider text-alpha-black mb-2">
                  Last Name
                </label>
                <input
                  type="text"
                  id="last-name"
                  name="last-name"
                  required
                  class="w-full rounded-none border border-alpha-black/20 bg-alpha-cream/20 pl-5 pr-4 py-3 text-sm text-alpha-black focus:border-alpha-gold-400 focus:bg-white focus:outline-none transition-colors"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-[0.7rem] font-semibold uppercase tracking-wider text-alpha-black mb-2">
                Email Address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-none border border-alpha-black/20 bg-alpha-cream/20 pl-5 pr-4 py-3 text-sm text-alpha-black focus:border-alpha-gold-400 focus:bg-white focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label for="affiliation" class="block text-[0.7rem] font-semibold uppercase tracking-wider text-alpha-black mb-2">
                Affiliation
              </label>
              <select
                id="affiliation"
                name="affiliation"
                class="w-full rounded-none border border-alpha-black/20 bg-alpha-cream/20 pl-5 pr-4 py-3 text-sm text-alpha-black focus:border-alpha-gold-400 focus:bg-white focus:outline-none transition-colors"
              >
                <option value="student">Cornell Student</option>
                <option value="alumnus">Alpha Alumnus</option>
                <option value="community">Community Member</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-[0.7rem] font-semibold uppercase tracking-wider text-alpha-black mb-2">
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="w-full rounded-none border border-alpha-black/20 bg-alpha-cream/20 pl-5 pr-4 py-3 text-sm text-alpha-black focus:border-alpha-gold-400 focus:bg-white focus:outline-none transition-colors resize-none"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full justify-center text-center">
              Send Message
            </button>
          </form>
        </div>

        {/* Location Details (Right / 5 Cols, adjusted padding) */}
        <div class="lg:col-span-5 lg:pl-8 lg:pt-4">
          <div>
            <span class="block text-[0.7rem] font-semibold uppercase tracking-wider text-alpha-gold-400 mb-1">
              Address
            </span>
            <p class="text-md text-alpha-ink/80 leading-relaxed">
              Alpha Phi Alpha Fraternity, Inc.<br />
              105 Westbourne Ln. <br />
              Ithaca, NY 14853
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* CTA: GET INVOLVED ================================================= */}
  <section class="bg-alpha-cream py-16 sm:py-20">
    <div class="container-wide max-w-4xl text-center">
      <h2 class="mt-3 font-serif text-4xl sm:text-5xl text-alpha-black">
        Stay connected with the Alpha Chapter.
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="https://www.instagram.com/alphachapter06/" target="_blank" rel="noopener noreferrer" class="btn-ghost">
          Follow on Instagram
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  input,
  select,
  textarea {
    padding-left: 0.5rem !important; /* Forces 24px left padding */
    padding-right: 0.5rem !important;
  }
</style>